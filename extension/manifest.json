{
  "manifest_version": 3,
  "name": "LinkedIn CLI Bridge",
  "version": "0.2.3",
  "key": "",
  "description": "Lets a local CLI service drive LinkedIn with real (trusted) clicks and keystrokes.",
  "permissions": [
    "debugger",
    "alarms",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkedIn CLI Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
